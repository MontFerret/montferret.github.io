{
  "schemaVersion": 1,
  "id": "montferret/archive",
  "version": "1.0.0-rc.3",
  "namespaces": [
    {
      "name": "ARCHIVE",
      "functions": [
        {
          "name": "EXTRACT",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "source",
                  "type": {
                    "kind": "union",
                    "types": [
                      {"kind": "named", "name": "String"},
                      {"kind": "named", "name": "Binary"}
                    ]
                  },
                  "description": "Archive content."
                },
                {
                  "name": "options",
                  "type": {"kind": "named", "name": "Object?"},
                  "description": "Extraction options."
                }
              ],
              "variadic": true,
              "description": "Extract writes eligible archive entries through the configured filesystem.",
              "return": {
                "type": {"kind": "named", "name": "Array<String>"},
                "description": "Extracted archive paths."
              },
              "throws": [
                {
                  "error": "ArchiveError",
                  "description": "The archive cannot be read."
                },
                {
                  "error": "PathError",
                  "description": "An entry path is unsafe."
                }
              ],
              "deprecated": "Use UNPACK instead."
            }
          ]
        },
        {
          "name": "LIST",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "args"
                }
              ],
              "variadic": true,
              "description": "List returns archive entry metadata."
            }
          ]
        },
        {
          "name": "READ",
          "signatures": [
            {
              "parameters": [
                {
                  "name": "args"
                }
              ],
              "variadic": true,
              "description": "Read returns one regular archive entry."
            }
          ]
        }
      ]
    }
  ]
}
